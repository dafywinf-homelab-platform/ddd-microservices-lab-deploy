{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/London",
  "labels": ["dependencies"],
  "prHourlyLimit": 0,
  "helm-values": {
    "managerFilePatterns": ["/(^|/)environments/[^/]+/[^/]+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/(^|/)environments/[^/]+/infra/[^/]+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Major updates wait in the Dependency Dashboard until approved there",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Continuous delivery: a new service release goes into SIT without review. Renovate pins the digest, opens the PR and merges it itself once Validate passes; Argo CD then deploys it",
      "matchPackageNames": ["ghcr.io/dafywinf/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "pinDigests": true,
      "automerge": true
    }
  ]
}
